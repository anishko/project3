# Copy to .env and fill in. NEVER commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Comma-separated. Production example: yourusername.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.pythonanywhere.com
# Production example: https://yourusername.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
# openai = real embeddings; hashing = offline/no key (low quality, for dev/tests only)
EMBEDDING_BACKEND=openai
RAG_TOP_K=4
# Leave blank for the default (0.15 openai / 0.05 hashing)
RAG_MIN_SCORE=
